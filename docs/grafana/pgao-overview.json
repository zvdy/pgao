{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operator overview for pgao — supervisor state, collection health, HTTP traffic, per-cluster Postgres metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "pgao on GitHub",
      "type": "link",
      "url": "https://github.com/zvdy/pgao",
      "targetBlank": true
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Cluster supervisor",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "1 = supervisor reports the cluster healthy. 0 = unhealthy / connecting / unknown.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP",   "color": "green" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_cluster_up{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "Cluster up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Connections to each cluster's Postgres backend over time.",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_connections_active{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}} active",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_connections_total{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}} max",
          "refId": "B"
        }
      ],
      "title": "Connections (active / max)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Collection health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Per-cluster collection error rate. Spikes mean a sub-collection (transactions, locks, replication, …) is failing — see logs filtered by cluster_id.",
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (cluster, kind) (rate(pgao_collection_errors_total{job=~\"$job\", cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{cluster}} / {{kind}}",
          "refId": "A"
        }
      ],
      "title": "Collection errors / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "p95 of a single per-cluster collection round, by kind. Approaching metrics.query_timeout = drop work or raise the cap.",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, cluster, kind) (rate(pgao_collection_duration_seconds_bucket{job=~\"$job\", cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "{{cluster}} / {{kind}}",
          "refId": "A"
        }
      ],
      "title": "Collection p95 duration",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "HTTP API",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Request rate by route template (cluster ID is rolled up into {id}).",
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (route, code) (rate(pgao_http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{route}} {{code}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "p95 handler latency by route. Spikes correlate with collection latency above when handlers call the collector synchronously (e.g. /queries).",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(pgao_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "Postgres health (per cluster)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Buffer cache hit ratio. < 99% on a steady-state OLTP workload usually means shared_buffers is undersized.",
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_cache_hit_ratio{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "Cache hit ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Transactions per second over the collection window.",
      "fieldConfig": { "defaults": { "unit": "tps" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_transactions_per_sec{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "Transactions / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Replay lag for standbys. Primary nodes report 0.",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_replication_lag_ms{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "Replication lag",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Deadlocks since last collection. Sustained > 0 = lock-ordering bug somewhere.",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 34 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_deadlock_count{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "Deadlocks",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Backends waiting on a lock right now.",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 34 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_lock_waits{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "title": "Lock waits",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Disk I/O attributed to Postgres backends.",
      "fieldConfig": { "defaults": { "unit": "KBs" } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 34 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_disk_io_read_kbps{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}} read",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "pgao_disk_io_write_kbps{job=~\"$job\", cluster=~\"$cluster\"}",
          "legendFormat": "{{cluster}} write",
          "refId": "B"
        }
      ],
      "title": "Disk I/O (KB/s)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pgao", "postgres", "observability"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(pgao_cluster_up, job)",
        "label": "Job",
        "multi": true,
        "name": "job",
        "query": { "qryType": 1, "query": "label_values(pgao_cluster_up, job)" },
        "refresh": 2,
        "type": "query",
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(pgao_cluster_up{job=~\"$job\"}, cluster)",
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "query": { "qryType": 1, "query": "label_values(pgao_cluster_up{job=~\"$job\"}, cluster)" },
        "refresh": 2,
        "type": "query",
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "pgao — Overview",
  "uid": "pgao-overview",
  "version": 1,
  "weekStart": ""
}
